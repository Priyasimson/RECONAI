{
  "name": "reconai",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "mobile"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "dev:mobile": "npm run start --workspace=mobile",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "postinstall": "node -e \"const fs=require('fs'),path=require('path');const t=path.join(__dirname,'mobile/node_modules/react-native'),l=path.join(__dirname,'node_modules/react-native');if(!fs.existsSync(l)&&fs.existsSync(t)){fs.symlinkSync(t,l,'junction');}\""
  },
  "devDependencies": {
    "concurrently": "^8.0.1",
    "exceljs": "^4.4.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2"
  }
}
